# Firebase web app settings: Firebase console → Project settings → General →
# Your apps → Web app → "SDK setup and configuration" → Config.
# On Vercel, add these under Project → Settings → Environment Variables.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Local development against the Firebase emulators (see README). Leave unset in production.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# ── Wall tablet (/kiosk) ───────────────────────────────────────────────────
# A code staff type once on each tablet to set it up. Make it long and random.
KIOSK_CODE=
# The Firebase service account key, as one line of JSON: Firebase console →
# Project settings → Service accounts → Generate new private key. Keep it
# secret: add it on Vercel only (never commit it, never NEXT_PUBLIC_).
FIREBASE_SERVICE_ACCOUNT=

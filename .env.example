# Firebase web app settings: Firebase console → Project settings → General →
# Your apps → Web app → "SDK setup and configuration" → Config.
# On Vercel, add these under Project → Settings → Environment Variables.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Local development against the Firebase emulators (see README). Leave unset in production.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# ── Wall tablet (/kiosk) ───────────────────────────────────────────────────
# A code staff type once on each tablet to set it up. Make it long and random.
KIOSK_CODE=
# The Firebase service account key, as one line of JSON: Firebase console →
# Project settings → Service accounts → Generate new private key. Keep it
# secret: add it on Vercel only (never commit it, never NEXT_PUBLIC_).
FIREBASE_SERVICE_ACCOUNT=

# ── Tablet fleet (PDCA kiosk) ──────────────────────────────────────────────
# Lets staff manage the wall tablets from Staff → Tablets (list, reboot, update,
# rotate, add new tablets). Get the key from PDCA: a super admin mints a partner
# key scoped to this program. Server-only secret — add it on Vercel only, never
# NEXT_PUBLIC_. Leave unset and the Tablets page simply says it isn't set up.
PDCA_PARTNER_API_KEY=
# Optional. The PDCA control API base; the default is correct for production.
# PDCA_FLEET_API_BASE=https://tcpdca.com/api/partner
# Optional. A new tablet is pointed at this OTA channel automatically when you
# add it — your kiosk-manifest.json URL (see kiosk-bundle/README.md).
# PDCA_KIOSK_MANIFEST_URL=https://your-domain/kiosk-manifest.json
